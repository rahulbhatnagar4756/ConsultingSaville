@code {
    [Inject] IBox9Service _box9Service { get; set; }
    [Inject] IEmployeeService _employeeService { get; set; }

    [CascadingParameter] OneCoreAssessUI.Services.RightSidebarService RightSideBar { get; set; } = default;
    [CascadingParameter] LayoutCascadeMenuModel MenuNav { get; set; } = default;

    //private EmployeeSearchModel _Search9BoxEmployees;
    /// <summary>
    /// this is used for search criteria with the 9box selected
    /// </summary>
    [Parameter] public EmployeeSearchModel Search9BoxEmployees { get; set; } = new();
    [Parameter] public EventCallback<EmployeeSearchModel> Search9BoxEmployeesChanged { get; set; }

    /// <summary>
    /// this is used for search criteria used with the filter
    /// </summary>
    [Parameter] public EmployeeSearchModel SearchFilter { get; set; } = new();
    [Parameter] public EventCallback<EmployeeSearchModel> SearchFilterChanged { get; set; }

    [Parameter] public EventCallback<string?> SuccessionStatusChanged { get; set; }

    //create a isMaster bool that is full data bind
    [Parameter] public bool IsMasterPage { get; set; } = true;
    [Parameter] public EventCallback<bool> IsMasterPageChanged { get; set; }



    private EmployeeSearchModel _searchEmployee = new();
    private TalentManagementStatisticModel _talentManagementStatistic = new();
    private List<EmployeesModel>? _employees = null;
    private bool _isLoading = true;
    private bool _isLoadingEmployees = false;

    protected override async Task OnInitializedAsync()
    {
        //if (_employeeService != null) _employees = await _employeeService.GetEmployees(_searchEmployee);
        if (_box9Service!= null)
        {
            _talentManagementStatistic = await _box9Service.GetBox9Statistics(SearchFilter);
            _isLoading = false;
        }

        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {

        if (MenuNav.isMasterDashboard){ 
            Search9BoxEmployees.UsersUUID = null;
            MenuNav.SetMasterDashboardOff(); 
        }

        if ((SearchFilter.Box9 != null && SearchFilter.Box9.Count() == 0)
             || SearchFilter != _searchEmployee)
        {
            if (!_searchEmployee.CompareEmployeeSearchModels(SearchFilter) && _box9Service != null)
            {
                _employees = null;
                _searchEmployee = (EmployeeSearchModel)SearchFilter.Clone();
                _searchEmployee.UsersUUID = null;
                _searchEmployee.UsersUUID = new();
                _talentManagementStatistic = await _box9Service.GetBox9Statistics(_searchEmployee);
            }
        }
        await base.OnParametersSetAsync();
    }


    private async Task OnSearch_Click(OneCoreAssessUI.Models.SearchModel args)
    {
        _searchEmployee.Search = args.Search;
        _searchEmployee.isIncludeTeam = args.isTeam;
        _searchEmployee.UsersUUID = null;
        _searchEmployee.UsersUUID = new();
        Search9BoxEmployees.UsersUUID = null;

        if (_box9Service!= null) _talentManagementStatistic = await _box9Service.GetBox9Statistics(_searchEmployee);
        await SearchFilterChanged.InvokeAsync(_searchEmployee);
        await InvokeAsync(StateHasChanged);
    }

    private async Task On9Box_Click(Box9Types box)
    {
        if (_searchEmployee == null) _searchEmployee = new();
        Search9BoxEmployees = (EmployeeSearchModel)_searchEmployee.Clone();
        if (Search9BoxEmployees.Box9 == null) Search9BoxEmployees.Box9 = new(); 
        Search9BoxEmployees.Box9.Clear();
        Search9BoxEmployees.Box9.Add((int)box);
        await Search9BoxEmployeesChanged.InvokeAsync(Search9BoxEmployees);

        RightSideBar.Open(Enumerables.ControlTypes.sb_9Box_Employee_levels);
    }

    /// <summary>
    /// filter clicks for the 9 box filter
    /// </summary>
    /// <param name="isFilterOnlyTalentpool"></param>
    /// <param name="isFilterOnlyOutStanding"></param>
    /// <param name="isFilterOnly9BoxPlotted"></param>
    /// <param name="isFilterOnlySuccessionReadiness"></param>
    /// <returns></returns>
    private async Task FilterClicks(bool isFilterOnlyTalentpool = false, bool isFilterOnlyOutStanding = false, bool isFilterOnly9BoxPlotted = false, bool isFilterOnlySuccessionReadiness = false)
    {
        _isLoadingEmployees = true;
        _isLoading = true;
        EmployeeSearchModel Search = (EmployeeSearchModel)_searchEmployee.Clone();
        Search.isFilterOnlyTalentpool = isFilterOnlyTalentpool;
        Search.isFilterOnlyOutStanding = isFilterOnlyOutStanding;
        Search.isFilterOnly9BoxPlotted  = isFilterOnly9BoxPlotted;
        Search.isFilterOnlySuccessionReadiness = isFilterOnlySuccessionReadiness;

        TalentManagementStatisticModel talent = (TalentManagementStatisticModel)_talentManagementStatistic.Clone();

        if (isFilterOnlyTalentpool || isFilterOnly9BoxPlotted || (!isFilterOnlyTalentpool && !isFilterOnlyOutStanding && !isFilterOnly9BoxPlotted && !isFilterOnlySuccessionReadiness))
        {
            _talentManagementStatistic = await _box9Service.GetBox9Statistics(Search);
            if (_talentManagementStatistic == null) _talentManagementStatistic = talent;

            _talentManagementStatistic.TotalEmployeeStats = talent.TotalEmployeeStats;
            _talentManagementStatistic.TalentPoolStats = talent.TalentPoolStats;
            _talentManagementStatistic.Box9PlottedStats = talent.Box9PlottedStats;
            _talentManagementStatistic.OutStandingStats = talent.OutStandingStats;
        }

        _employees = await _employeeService.GetEmployees(Search);
        //if _employee is not null the sort by 9box, level, name
        if (_employees != null) _employees.OrderBy(x => x.Box9Name).ThenBy(x => x.LevelOrder).ThenBy(x => x.FirstName).ThenBy(x => x.LastName);

        _isLoadingEmployees = false;
        _isLoading = false;
    }

    private async Task OnFilterTalentPool_Click() =>
        await FilterClicks(isFilterOnlyTalentpool: true);

    private async Task OnFilterOutStanding_Click() =>
        await FilterClicks(isFilterOnlyOutStanding: true);

    private async Task OnFilter9BoxPlotted_Click() =>
        await FilterClicks(isFilterOnly9BoxPlotted: true);

    private async Task OnFilterSuccessionReadiness_Click() =>
        await FilterClicks(isFilterOnlySuccessionReadiness: true);

    private async Task OnFilterAll_Click() =>
       await FilterClicks();

    private async Task OnEmployeeClick(EmployeesModel employee)
    {
        if (employee == null || employee.UsersUUID == null) return;

        Search9BoxEmployees.UsersUUID = null;
        Search9BoxEmployees.UsersUUID = new();
        Search9BoxEmployees.UsersUUID.Add(employee.UsersUUID);
    }

    private async Task OnSuccessionStatusChanged(string? value) =>
        await SuccessionStatusChanged.InvokeAsync(value);

}
