<RadzenCard class="box9TM mt-3" style="box-shadow: var(--rz-shadow-5)">
    <RadzenStack>
        <RadzenRow>
            <RadzenColumn Size="1" class="action-outer">
                <RadzenStack class="action-bar ">
                    <RadzenText class=" ">
                        Action
                   </RadzenText>  
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn class="action-types">
                @if (_talentManagementUserStatistic != null && _talentManagementUserStatistic.Box9TypeActions != null)
                {
                    @((MarkupString)_talentManagementUserStatistic.Box9TypeActions)
                }
            </RadzenColumn>
        </RadzenRow>

    </RadzenStack>

</RadzenCard>



@code {
    [Inject] private IBox9Service _box9Service { get; set; }

    [Parameter] public string? UsersUUID { get; set; }

    private TalentManagementUsersStatisticModel _talentManagementUserStatistic = new();
    private bool _isLoading = false;
    private string? _UsersUUIDCurrent;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        if (_UsersUUIDCurrent != UsersUUID)
        {
            _UsersUUIDCurrent = UsersUUID;
            _talentManagementUserStatistic = await _box9Service.GetBox9StatisticsForUser(UsersUUID);
            if (_talentManagementUserStatistic == null) _talentManagementUserStatistic = new();
        }
        _isLoading = false;
        await base.OnParametersSetAsync();
    }



}
