@using Library.Frog.Services

@if (Element != null)
{
    <RadzenStack Gap="5px" class=@string.Format("form {0} {1}", Element.CSSClass, CSSClass)>
        @if (isShowLabel)
        {
            <RadzenLabel  class="form-label" >
                @((MarkupString)_Label)
            </RadzenLabel>
        }
        <RadzenDropDown @bind-Value=_dropdownValue 
                        Data=@_Lookups 
                        TextProperty="@nameof(Library.Frog.Models.FrogLookupModel.Name)" 
                        ValueProperty="@nameof(Library.Frog.Models.FrogLookupModel.UUID)"
                        Style=@Element.Style class=@string.Format("form-control {0}" , _active)
                        ReadOnly=@(Element.FrogSecurityPermissionsId == _readonly)  
                        Change="Save" />
    </RadzenStack>
}

@code {
    [Inject] IFrogService FrogService { get; set; }
    [Inject] private IServiceProvider ScopedServices { get; set; }

    [Parameter] public EventCallback OnValueChanged { get; set; }

    [Parameter] public Library.Frog.Models.FrogElementModel Element { get; set; }
    [Parameter] public string CompanyUUID { get; set; }
    [Parameter] public string UsersUUIDLoggedIn { get; set; }

    [Parameter] public bool isShowLabel { get; set; } = true;
    [Parameter] public string CSSClass { get; set; } = "";

    private List<Library.Frog.Models.FrogLookupModel> _Lookups = new();
    private string _dropdownValue;
    private string _active = "";
    private int _readonly = 2;

    private Library.Frog.Models.FrogElementModel _ElementCurrent = null;

    private string _Label { get
        {
            string Required = "";
            if (Element.IsRequired.HasValue && Element.IsRequired.Value) Required = @"<span Style=""color: red;"">*</span> ";

            return Required + Element.Label;
        } }


    protected override async Task OnInitializedAsync()
    {
        if (Element != null) 
        {
            _ElementCurrent = (Library.Frog.Models.FrogElementModel)Element.Clone();
            await LoadElement(); 
        }
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Element != null)
        {
            if (_ElementCurrent != Element)
            {
                _ElementCurrent = (Library.Frog.Models.FrogElementModel)Element.Clone();
                await LoadElement();
            }

        }

        await base.OnParametersSetAsync();
    }

    /// <summary>
    /// load the looks to populate the dropdown
    /// </summary>
    /// <returns></returns>
    private async Task LoadElement()
    {
        if (Element.FrogLookupTypesId != null)
        {
            await LoadLookup(Element.FrogLookupTypesId.Value);
            if (Element == null || string.IsNullOrWhiteSpace(Element.ResultValue)) return;
            _dropdownValue = Element.ResultValue;
        }
        else
        {
            if (Element.FrogSQLStoredProceduresUUID != null)
            {
                await LoadLookupByStoreProcedure();
                if (Element == null || string.IsNullOrWhiteSpace(Element.ResultValue)) return;
                _dropdownValue = Element.ResultValue;
            }
        }
    }

    /// <summary>
    /// get the lookup data from the database
    /// </summary>
    /// <param name="lookupTypesid"></param>
    /// <returns></returns>
    private async Task LoadLookup(int lookupTypesid) =>
        _Lookups = await FrogService.GetLookups(lookupTypesid);

    /// <summary>
    /// execute the stored procedure to generate the lookup
    /// </summary>
    /// <returns></returns>
    private async Task LoadLookupByStoreProcedure() =>
        _Lookups = await FrogService.GetLookupsByStoredProcedure(CompanyUUID, UsersUUIDLoggedIn, Element.FormsUUID, Element.FrogSQLStoredProceduresUUID);


    private async Task Save(object value)
    {
        Library.Frog.Models.FrogElementSaveLogModel element = new()
        {
            CompanyUUID = CompanyUUID,
            UsersUUIDLoggedIn = UsersUUIDLoggedIn,
            FrogElementsUUID = Element.FrogElementsUUID,
            FrogsUUID = Element.FormsUUID,
            ItemUUID = value.ToString()
        };

        var selectedOption = _Lookups.FirstOrDefault(option => option.UUID == value);
        if (selectedOption != null && selectedOption.Name != null)
        {
            element.ItemName = selectedOption.Name; 
        }


        var result = await FrogService.Save(element);
        if (result == null) return;
        if (result.isSuccess != null && result.isSuccess.Value) _active = "active";

        try
        {
            await OnValueChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error invoking OnValueChanged: {ex.Message}");
        }

        StateHasChanged();

        
    }
}
