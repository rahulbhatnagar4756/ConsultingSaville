@code {
    [Inject] public IContractResultsService? ContractResultsService { get; set; }

    [CascadingParameter] public RightSidebarService? _rightSidebarService { get; set; }
    [CascadingParameter] public LayoutCascadeMenuModel? _menuNav { get; set; }

    [Parameter] public Enumerables.MenuItemSubTypes ItemSub { get; set; }
    [Parameter] public EventCallback<Enumerables.MenuItemSubTypes> ItemSubChanged { get; set; }


    private string _selectedUsersUUID = string.Empty;

    private const string DEFAULT_CONTRACT_UUID = "52483E04-30AD-489D-9951-AB788B312EA5";

    private ContractResults? _contractResults;
    private List<KpiDisplayItem> _allKpiItems = new();

    private Dictionary<string, bool> _pillarExpandedState = new();
    private string _searchText = string.Empty;
    private string _activeStatusFilter = "all";
    private bool _selectAll = false;
    private bool _isLoading = true;
    private bool _hasError = false;
    private string _errorMessage = string.Empty;
    private bool _isManagerOrAdmin = false;

    // Animation state
    private bool _isPeriodTransitioning = false;
    private const int FadeDurationMs = 500;

    protected override async Task OnInitializedAsync()
    {
        if (_rightSidebarService != null)
        {
            _rightSidebarService.OnDataRefresh += HandleDataRefresh;
        }


        var contextString = _menuNav.GetSharedContext<string>();
        if (!string.IsNullOrEmpty(contextString))
        {
            var parts = contextString.Split(';')
                                        .Select(p => p.Split('='))
                                        .Where(p => p.Length == 2)
                                        .ToDictionary(a => a[0], a => a[1]);

            _selectedUsersUUID = parts.ContainsKey("UsersUUID") ? parts["UsersUUID"] : null;
        }

        await LoadData();
        await base.OnInitializedAsync();
    }

    private async Task LoadData(string? ratingPeriodUUID = null)
    {
        _isLoading = true;
        _hasError = false;
        StateHasChanged();

        try
        {
            if (ContractResultsService == null)
            {
                throw new Exception("ContractResultsService is not available");
            }

            ContractResultsResponse? response = new ContractResultsResponse();

            if (ratingPeriodUUID == null)
            {
                
                if (!string.IsNullOrEmpty(_selectedUsersUUID))
                {
                    // Filter the data to only matching _usersUUID
                    response = await ContractResultsService.GetContractResults(DEFAULT_CONTRACT_UUID, _selectedUsersUUID);
                }
                else
                {
                    response = await ContractResultsService.GetContractResults(DEFAULT_CONTRACT_UUID,null);
                }

                _ratingPeriodsDto = await ContractResultsService.GetRatingPeriods();
                _activePeriodIndex = 0;
            }
            else
            {
                response = await FilterContractsByRatingPeriod(ratingPeriodUUID);
            }


            if (response?.Data == null || !response.Data.Any())
            {
                _hasError = true;
                _errorMessage = "No contract results found";
                return;
            }

            _contractResults = response.Data.First();

            _isManagerOrAdmin = _contractResults.IsManagerOrAdmin;

            ProcessContractData();

            NotificationService?.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Data Loaded",
                Detail = "Contract results loaded successfully",
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = ex.Message;
            NotificationService?.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Failed to load contract results: {ex.Message}",
                Duration = 5000
            });
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Opens the RightSidebar with the selected KPA or KPI item.
    /// </summary>
    private void OpenSidebarWithItem(KpiDisplayItem item)
    {
        if (_rightSidebarService != null && _contractResults != null)
        {
            var context = new KpiSidebarContext
            {
                ContractResults = _contractResults,
                SelectedItem = item
            };

            _rightSidebarService.Open(ControlTypes.sb_Goals_EmployeeGoals, context);
        }
    }

    /// <summary>
    /// Opens the RightSidebar with the selected KPA or KPI item.
    /// </summary>
    private void OpenGlobalCommentsSidebarWithItem(KpiDisplayItem item)
    {
        if (_rightSidebarService != null && _contractResults != null)
        {
            var context = new KpiSidebarContext
            {
                ContractResults = _contractResults,
                SelectedItem = item
            };

            _rightSidebarService.Open(ControlTypes.sb_Goals_GlobalComments, context);
        }
    }


    private void ProcessContractData()
    {
        _allKpiItems.Clear();
        _pillarExpandedState.Clear();

        if (_contractResults?.EnterpriseStructures == null) return;

        foreach (var structure in _contractResults.EnterpriseStructures)
        {
            if (structure.Pillars == null) continue;

            foreach (var pillar in structure.Pillars)
            {
                // Initialize pillar as expanded by default using Dictionary
                if (pillar.UUID != null)
                {
                    _pillarExpandedState[pillar.UUID] = true;
                }

                if (pillar.KPA == null) continue;

                foreach (var kpa in pillar.KPA)
                {
                    // Add KPA as KPI item
                    _allKpiItems.Add(new KpiDisplayItem
                    {
                        UUID = kpa.UUID,
                        PillarRef = pillar,
                        Name = kpa.Name ?? "Unnamed KPA",
                        Description = kpa.Description,
                        Type = "KPA",
                        RatingPeriods = kpa.RatingPeriods,
                        RatingPeriodsDisplay = kpa.RatingPeriodsDisplay,
                        RatingPeriodDates = kpa.RatingPeriodDates,
                        Status = kpa.Status,
                        StatusScoreColor = kpa.StatusScoreColor,
                        Template = kpa.Template,
                        Weight = kpa.Weight,
                        ScoreEmployee = kpa.ScoreEmployee,
                        ScoreManager = kpa.ScoreManager,
                        IsActive = kpa.IsActive
                    });

                    // Add child KPIs
                    if (kpa.KPI != null)
                    {
                        foreach (var kpi in kpa.KPI)
                        {
                            _allKpiItems.Add(new KpiDisplayItem
                            {
                                UUID = kpi.UUID,
                                PillarRef = pillar,
                                Name = kpi.Name ?? "Unnamed KPI",
                                Description = kpi.Description,
                                Type = "KPI",
                                RatingPeriods = kpi.RatingPeriods,
                                RatingPeriodsDisplay = kpi.RatingPeriodsDisplay,
                                RatingPeriodDates = kpi.RatingPeriodDates,
                                Status = kpi.Status,
                                StatusScoreColor = kpi.StatusScoreColor,
                                Template = kpi.Template,
                                Weight = kpi.Weight,
                                ScoreEmployee = kpi.ScoreEmployee,
                                ScoreManager = kpi.ScoreManager,
                                IsActive = kpi.IsActive,
                                Target = kpi.Target
                            });
                        }
                    }

                    // Add linked KPIs
                    if (kpa.KPILinked != null)
                    {
                        foreach (var linkedKpi in kpa.KPILinked)
                        {
                            _allKpiItems.Add(new KpiDisplayItem
                            {
                                UUID = linkedKpi.UUID,
                                PillarRef = pillar,
                                Name = linkedKpi.Name ?? "Unnamed Linked KPI",
                                Description = linkedKpi.Description,
                                Type = "Linked KPI",
                                RatingPeriods = linkedKpi.RatingPeriods,
                                RatingPeriodsDisplay = linkedKpi.RatingPeriodsDisplay,
                                RatingPeriodDates = linkedKpi.RatingPeriodDates,
                                Status = linkedKpi.Status,
                                StatusScoreColor = linkedKpi.StatusScoreColor,
                                Template = linkedKpi.Template,
                                Weight = linkedKpi.Weight,
                                ScoreEmployee = linkedKpi.ScoreEmployee,
                                ScoreManager = linkedKpi.ScoreManager,
                                IsActive = true
                            });
                        }
                    }
                }
            }
        }
    }

    private void OnSearchChanged(string? searchValue)
    {
        _searchText = searchValue ?? string.Empty;
        StateHasChanged();
    }

    private void PerformSearch()
    {
        StateHasChanged();
    }

    private List<KpiDisplayItem> GetFilteredKpis()
    {
        var filtered = _allKpiItems.AsEnumerable();

        if (!string.IsNullOrEmpty(_searchText))
        {
            filtered = filtered.Where(k =>
                k.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (k.Description?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (k.Template?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (_activeStatusFilter != "all")
        {
            filtered = filtered.Where(k => GetPerformanceLevel(k) == _activeStatusFilter);
        }

        return filtered.ToList();
    }

    private int GetFilteredKpisCount() => GetFilteredKpis().Count;
    private string GetTotalKpisCount() => _allKpiItems.Count.ToString();

    private List<KpiDisplayItem> GetFilteredKpisByPillar(Library.API.Goals.Models.Contracts.Pillar pillar)
    {
        return GetFilteredKpis().Where(k => k.PillarRef == pillar).ToList();
    }

    private void FilterByStatus(string status)
    {
        _activeStatusFilter = status;
        StateHasChanged();
    }

    private string GetStatCardClass(string status)
    {
        return $"stat_card {(_activeStatusFilter == status ? "active" : "")}";
    }

    private string GetStatusCount(string status)
    {
        return _allKpiItems.Count(k => GetPerformanceLevel(k) == status).ToString();
    }

    private string GetPerformanceLevel(KpiDisplayItem kpi)
    {
        var avgScore = ((kpi.ScoreEmployee ?? 0) + (kpi.ScoreManager ?? 0)) / 2;
        if (avgScore >= 80) return "high";
        if (avgScore >= 50) return "medium";
        return "low";
    }

    private void OnSelectAllChanged(bool value)
    {
        _selectAll = value;
        foreach (var kpi in GetFilteredKpis())
            kpi.IsSelected = value;
        StateHasChanged();
    }

    private void OnKpiSelectionChanged(bool value)
    {
        var filteredKpis = GetFilteredKpis();
        _selectAll = filteredKpis.Any() && filteredKpis.All(k => k.IsSelected);
        StateHasChanged();
    }

    private bool HasSelectedItems() => _allKpiItems.Any(k => k.IsSelected);


    private async Task ExportSelected()
    {
        try
        {
            var selectedKpis = _allKpiItems.Where(k => k.IsSelected).ToList();
            if (!selectedKpis.Any())
            {
                await DialogService.Alert("No items selected for export.", "Export");
                return;
            }

            using var workbook = new XLWorkbook();
            var worksheet = workbook.Worksheets.Add("Selected KPIs");

            // Updated headers — moved Type after Parent_Goal
            string[] headers = new[]
            {
            "GoalidParent", "Goalid","Type", "Parent_Goal", "Goal", "Description",
            "Employee", "IDNumber", "EmployeeNumber", "BusinessUnits", "Department",
            "Position", "Target",
            "Jan Employee Score", "Jan Manager Score",
            "Feb Employee Score", "Feb Manager Score",
            "Mar Employee Score", "Mar Manager Score",
            "Apr Employee Score", "Apr Manager Score",
            "May Employee Score", "May Manager Score",
            "Jun Employee Score", "Jun Manager Score",
            "Jul Employee Score", "Jul Manager Score",
            "Aug Employee Score", "Aug Manager Score",
            "Sep Employee Score", "Sep Manager Score",
            "Oct Employee Score", "Oct Manager Score",
            "Nov Employee Score", "Nov Manager Score",
            "Dec Employee Score", "Dec Manager Score",
            "Comments"
        };

            // Add headers
            for (int i = 0; i < headers.Length; i++)
            {
                worksheet.Cell(1, i + 1).Value = headers[i];
            }

            // Create lookup of KPA items
            var kpaItems = _allKpiItems.Where(k => k.Type == "KPA").ToList();

            // Group data so each KPA is followed by its KPIs
            var groupedData = new List<KpiDisplayItem>();
            foreach (var kpa in kpaItems)
            {
                // Add the KPA first
                if (selectedKpis.Any(k => k.UUID == kpa.UUID))
                    groupedData.Add(kpa);

                // Then add KPIs belonging to this KPA
                var relatedKpis = _allKpiItems
                    .Where(k => (k.Type == "KPI" || k.Type == "Linked KPI") && k.PillarRef == kpa.PillarRef)
                    .ToList();

                foreach (var kpi in relatedKpis)
                {
                    if (selectedKpis.Any(k => k.UUID == kpi.UUID))
                        groupedData.Add(kpi);
                }
            }

            // Add any orphan KPIs (no parent KPA)
            var orphanKpis = selectedKpis
                .Where(k => k.Type != "KPA" && !groupedData.Any(g => g.UUID == k.UUID))
                .ToList();
            groupedData.AddRange(orphanKpis);

            // Fill data
            for (int i = 0; i < groupedData.Count; i++)
            {
                var kpi = groupedData[i];
                int row = i + 2;

                string parentGoal = string.Empty;
                string goal = kpi.Name;
                string goalIdParent = string.Empty;

                if (kpi.Type == "KPA")
                {
                    parentGoal = "";
                    goalIdParent = kpi.UUID;
                }
                else if (kpi.Type == "KPI" || kpi.Type == "Linked KPI")
                {
                    var parentKpa = _allKpiItems
                        .Where(k => k.Type == "KPA" && k.PillarRef == kpi.PillarRef)
                        .LastOrDefault(k => _allKpiItems.IndexOf(k) < _allKpiItems.IndexOf(kpi));

                    if (parentKpa != null)
                    {
                        parentGoal = parentKpa.Name;
                        goalIdParent = parentKpa.UUID;
                    }
                }

                worksheet.Cell(row, 1).Value = goalIdParent; // GoalidParent
                worksheet.Cell(row, 2).Value = kpi.UUID; // Goalid
                worksheet.Cell(row, 3).Value = kpi.Type; // Type
                worksheet.Cell(row, 4).Value = parentGoal; // Parent_Goal
                worksheet.Cell(row, 5).Value = goal; // Goal
                worksheet.Cell(row, 6).Value = kpi.Description ?? "";
                worksheet.Cell(row, 7).Value = _contractResults?.ContractOwnerName ?? "";
                worksheet.Cell(row, 8).Value = _contractResults?.EmployeeDetails?.IDNumber ?? "";
                worksheet.Cell(row, 9).Value = _contractResults?.EmployeeDetails?.EmployeeNumber ?? "";
                worksheet.Cell(row, 10).Value = _contractResults?.EmployeeDetails?.EmployeeBusinessUnits ?? "";
                worksheet.Cell(row, 11).Value = _contractResults?.EmployeeDetails?.EmployeeDepartments ?? "";
                worksheet.Cell(row, 12).Value = _contractResults?.EmployeeDetails?.EmployeeJobs ?? "";
                worksheet.Cell(row, 13).Value = kpi.Target ?? 0;
                worksheet.Cell(row, 38).Value = kpi.Status ?? ""; // Comments
            }

            // Define range
            var tableRange = worksheet.Range(1, 1, groupedData.Count + 1, headers.Length);
            var table = tableRange.CreateTable("KpiExportTable");
            table.Theme = XLTableTheme.TableStyleMedium2;

            worksheet.Columns().AdjustToContents();
            worksheet.SheetView.FreezeRows(1);
            worksheet.Row(1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            worksheet.Row(1).Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

            using var stream = new MemoryStream();
            workbook.SaveAs(stream);
            stream.Position = 0;

            var base64 = Convert.ToBase64String(stream.ToArray());
            var fileName = $"Selected_KPIs_{DateTime.Now:yyyyMMddHHmmss}.xlsx";
            await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", base64, fileName);

            NotificationService?.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Export Successful",
                Detail = $"Exported {groupedData.Count} items successfully",
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            await DialogService.Alert($"Export failed: {ex.Message}", "Export");
        }
    }


    private async Task DuplicateResults()
    {
        var selectedKpis = _allKpiItems.Where(k => k.IsSelected).ToList();
        if (selectedKpis?.Any() == true)
            await DialogService.Alert($"{selectedKpis.Count} item(s) selected for duplication.", "Duplicate");
    }

    /// <summary>
    /// Handles refresh events triggered by the RightSidebarService.
    /// Reloads data and updates the UI when certain control types are refreshed.
    /// </summary>
    /// <param name="controlType">Type of control that triggered refresh.</param>
    private async void HandleDataRefresh(ControlTypes controlType)
    {
        if (controlType == ControlTypes.sb_Goals_EmployeeGoals)
        {
            await InvokeAsync(async () => await LoadData());
            StateHasChanged(); //  UI updates
        }
        else if (controlType == ControlTypes.sb_Goals_GlobalComments)
        {
            await InvokeAsync(async () => await LoadData());
            StateHasChanged(); //  UI updates
        }
    }

    public void Dispose()
    {
        if (_rightSidebarService != null)
            _rightSidebarService.OnDataRefresh -= HandleDataRefresh;

        // Clear the shared context
        _menuNav?.SetSharedContext(null);
    }

    private string GetProgressColorClass(decimal? score)
    {
        if (score == null) return "progress-gray";
        if (score >= 80) return "progress-green";
        if (score >= 50) return "progress-yellow";
        return "progress-red";
    }

    // Helper methods for managing pillar expanded state
    private bool IsPillarExpanded(Library.API.Goals.Models.Contracts.Pillar pillar)
    {
        if (pillar.UUID == null) return true;
        return _pillarExpandedState.TryGetValue(pillar.UUID, out var isExpanded) && isExpanded;
    }

    private void TogglePillarExpanded(Library.API.Goals.Models.Contracts.Pillar pillar)
    {
        if (pillar.UUID == null) return;

        if (_pillarExpandedState.ContainsKey(pillar.UUID))
        {
            _pillarExpandedState[pillar.UUID] = !_pillarExpandedState[pillar.UUID];
        }
        else
        {
            _pillarExpandedState[pillar.UUID] = false;
        }
        StateHasChanged();
    }

    // Calculate performance status based on scores
    private PerformanceStatus GetPerformanceStatus(double? scoreEmployee, double? scoreManager)
    {
        // Calculate average of both scores
        var avgScore = ((scoreEmployee ?? 0) + (scoreManager ?? 0)) / 2;

        if (avgScore == 0)
            return PerformanceStatus.NotStarted;
        else if (avgScore < 50)
            return PerformanceStatus.BelowTarget;
        else if (avgScore >= 50 && avgScore < 70)
            return PerformanceStatus.OnTarget;
        else if (avgScore >= 70 && avgScore < 90)
            return PerformanceStatus.Excellent;
        else // avgScore >= 90
            return PerformanceStatus.SuperStar;
    }

    // Get status display text
    private string GetStatusDisplayText(PerformanceStatus status)
    {
        return status switch
        {
            PerformanceStatus.SuperStar => "Super Star",
            PerformanceStatus.Excellent => "Excellent",
            PerformanceStatus.OnTarget => "On Target",
            PerformanceStatus.BelowTarget => "Below Target",
            PerformanceStatus.NotStarted => "Not Started",
            _ => "Unknown"
        };
    }

    // Get status badge style with color coding
    private string GetStatusBadgeStyle(PerformanceStatus status)
    {
        var (backgroundColor, textColor) = status switch
        {
            PerformanceStatus.SuperStar => ("#FFD700", "#000"),   // Gold with black text
            PerformanceStatus.Excellent => ("#90C850", "#fff"),   // Green
            PerformanceStatus.OnTarget => ("#4A90E2", "#fff"),    // Blue
            PerformanceStatus.BelowTarget => ("#FFA500", "#fff"), // Orange
            PerformanceStatus.NotStarted => ("#6c757d", "#fff"),  // Gray
            _ => ("#6c757d", "#fff")
        };

        return $"background: {backgroundColor}; color: {textColor}; font-size: 11px; padding: 4px 12px; font-weight: 500; white-space: nowrap;";
    }


    private List<RatingPeriodsDto?> _ratingPeriodsDto = new();

    // Active period navigation state
    private int _activePeriodIndex = 0;

    // Computed properties
    private bool _hasPreviousPeriod => _activePeriodIndex > 0;
    private bool _hasNextPeriod => _activePeriodIndex < _ratingPeriodsDto.Count - 1;

    private string _activePeriodLabel =>
        _ratingPeriodsDto.Count == 0
            ? "No Period"
            : _ratingPeriodsDto[_activePeriodIndex]?.RatingPeriodName ?? "Unknown";


    private async Task GoToPreviousPeriod()
    {
        if (!_hasPreviousPeriod) return;

        _isPeriodTransitioning = true;
        StateHasChanged();

        await Task.Delay(FadeDurationMs);

        _activePeriodIndex--;
        var period = _ratingPeriodsDto[_activePeriodIndex];

        await LoadData(period?.RatingPeriodUUID);

        _isPeriodTransitioning = false;
        StateHasChanged();
    }

    private async Task GoToNextPeriod()
    {
        if (!_hasNextPeriod) return;

        _isPeriodTransitioning = true;
        StateHasChanged();

        await Task.Delay(FadeDurationMs);

        _activePeriodIndex++;
        var period = _ratingPeriodsDto[_activePeriodIndex];

        await LoadData(period?.RatingPeriodUUID);

        _isPeriodTransitioning = false;
        StateHasChanged();
    }




    public async Task<ContractResultsResponse> FilterContractsByRatingPeriod(string ratingPeriodUUID)
    {
        var response = await ContractResultsService.GetContractResults(DEFAULT_CONTRACT_UUID);
        var data = response?.Data;

        if (data == null || !data.Any())
            return new ContractResultsResponse { Data = new List<ContractResults>() };

        // Take the first contract and filter it
        var contract = data.First();

        foreach (var structure in contract.EnterpriseStructures ?? new List<EnterpriseStructure>())
        {
            foreach (var pillar in structure.Pillars ?? new List<Pillar>())
            {
                // Filter KPA by RatingPeriodsUUID
                pillar.KPA = pillar.KPA?
                    .Where(kpa => kpa.RatingPeriodsUUID == ratingPeriodUUID)
                    .ToList();

                // Filter KPI inside remaining KPAs
                foreach (var kpa in pillar.KPA ?? new List<KPA>())
                {
                    kpa.KPI = kpa.KPI?
                        .Where(kpi => kpi.RatingPeriodsUUID == ratingPeriodUUID)
                        .ToList();
                }
            }
        }

        // Wrap the filtered contract inside ContractResultsResponse
        return new ContractResultsResponse
        {
            Data = new List<ContractResults> { contract }
        };
    }

}



