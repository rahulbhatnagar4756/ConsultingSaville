@using Library.API.Goals.Models
@using Library.API.Goals.Models.Templates
@using Library.API.Goals.Models.Tolerances
@using Library.API.Goals.Services
@using OneCoreAssessUI.Enumerables
@using OneCoreAssessUI.Models
@using OneCoreAssessUI.Services

@inject DialogService DialogService

<style>
    .resizable-html-editor {
        resize: both;
        overflow: auto;
        min-height: 200px;
        min-width: 100%;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .resizable-html-editor .rz-html-editor {
        height: 100% !important;
        width: 100% !important;
    }

    .resizable-html-editor .rz-html-editor .ql-container {
        height: calc(100% - 42px) !important;
    }

    .resizable-html-editor .rz-html-editor .ql-editor {
        min-height: 150px;
    }
</style>

<RadzenStack class="container rz-p-4" Style="max-height: calc(100vh - 100px); overflow-y: auto; padding-bottom: 2rem;">
    <RadzenStack>
        @* Header *@
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <RadzenText Text="Tolerance Set" Style="font-weight: 700; font-size: 20px;" />
        </RadzenStack>

        @if (_logMessage != null && _logMessage.isValid.HasValue)
        {
            <div class="rz-alert @(_logMessage.isValid.Value ? "rz-success-light" : "rz-danger-light")" style="margin-bottom: 1rem; display: flex; align-items: center;">
                <RadzenIcon Icon=@(_logMessage.isValid.Value ? "check_circle" : "error") Style="margin-right: 8px;" />
                <span>@_logMessage.Message</span>
            </div>
        }

        @* Loading Indicator *@
        @if (_isLoading)
        {
            <RadzenCard class="rz-text-align-center rz-p-4">
                <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                    <RadzenText Text="Loading..." />
                </RadzenStack>
            </RadzenCard>
        }
        else
        {
            @* Form with Tabs *@
            <RadzenTabs TabPosition="TabPosition.Top" RenderMode="TabRenderMode.Client" @bind-SelectedIndex="_selectedTabIndex">
                <Tabs>
                    <RadzenTabsItem Text="Basic">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12">
                                <RadzenText Text="Name" Variant="Variant.Outlined" />
                                <RadzenTextBox @bind-Value="_toleranceSet.Name"
                                               Style="width: 100%;"
                                               Placeholder="Enter tolerance set name..." />
                            </RadzenColumn>

                            <RadzenColumn Size="12">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.End" class="mb-2">
                                    <RadzenText Text="Description" Variant="Variant.Outlined" />
                                    <RadzenButton Icon="add" 
                                                  Text="Add Range"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Click="@AddCurrentRangeToDescription"
                                                  Disabled="@(_toleranceSet.UUID == null || _currentToleranceRanges == null || !_currentToleranceRanges.Any())"
                                                  Tooltip="Add the current tolerance ranges to the description" />
                                </RadzenStack>
                                <div class="resizable-html-editor" style="height: 200px; width: 100%;">
                                    <RadzenHtmlEditor @bind-Value="_toleranceSet.Description"
                                                      Style="height: 100%; width: 100%;"
                                                      Placeholder="Enter description..." />
                                </div>
                            </RadzenColumn>

                            <RadzenColumn Size="12">
                                <RadzenText Text="Maximum Total" Variant="Variant.Outlined" />
                                <RadzenNumeric @bind-Value="_toleranceSet.MaxTotal"
                                               Style="width: 100%;"
                                               Min="0"
                                               Max="1000"
                                               Step="0.1m"
                                               Format="F1"
                                               Placeholder="100.0" />
                            </RadzenColumn>

                            <RadzenColumn Size="12">
                                <RadzenText Text="Display Order" Variant="Variant.Outlined" />
                                <RadzenNumeric @bind-Value="_toleranceSet.OrderVal"
                                               Style="width: 100%;"
                                               Min="1"
                                               Max="999"
                                               Step="1"
                                               Placeholder="1" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Ranges" Visible="@(_toleranceSet.UUID != null)">
                        <OneCoreAssessUI.Components.Pages.Goals.Administration.Tolerances.sbTolerance.Components.SBToleranceRanges @ref="_toleranceRangesComponent"
                            ToleranceSetUUID="@_toleranceSet.UUID" 
                            OnRangeChanged="@OnRangeChanged" />
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>

            @* Show save/delete buttons only when not on Ranges tab *@
            @if (!IsRangesTabSelected())
            {
                <RadzenColumn Size="12" class="mt-5 mb-5">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px" style="width: 100%">
                        <RadzenButton style="flex: 1;"
                                      Icon="save"
                                      BusyText="Saving ..."
                                      IsBusy="_isSaving"
                                      Click=@SaveToleranceSet
                                      Text="Save" />

                        @if (!string.IsNullOrEmpty(_toleranceSet?.UUID))
                        {
                            <RadzenButton Icon="delete"
                                          Style="color: #fff; background-color: var(--rz-danger); width: 40px; min-width: 40px;"
                                          IsBusy="_isSaving"
                                          Click=OnDelete_Confirm />
                        }
                    </RadzenStack>
                </RadzenColumn>
            }
        }
    </RadzenStack>
</RadzenStack>

@code {
    [Inject] private ITolerancesServices TolerancesService { get; set; }
    [CascadingParameter] public RightSidebarService _rightSidebarService { get; set; }

    [Parameter] public EventCallback<ToleranceSetsModel> OnSaveComplete { get; set; }

    private ToleranceSetsModel _toleranceSet = new();
    private ToleranceSetsModel _toleranceSetCurrent;
    private ResultsModel? _logMessage = null;
    private List<ToleranceRangesModel>? _currentToleranceRanges = null;
    private OneCoreAssessUI.Components.Pages.Goals.Administration.Tolerances.sbTolerance.Components.SBToleranceRanges? _toleranceRangesComponent;
    
    // Track the selected tab index
    private int _selectedTabIndex = 0;
    
    private bool _isLoading = false;
    private bool _isSaving = false;
    private bool _isAddMode = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        //get data if its sent to the right sidebar area
        _toleranceSetCurrent = _rightSidebarService.GetSharedContext<ToleranceSetsModel>();

        if (_toleranceSet != null && _toleranceSetCurrent == null) 
            _toleranceSet = new ToleranceSetsModel { MaxTotal = 100, OrderVal = 1 };

        if (_toleranceSetCurrent != null && _toleranceSet != _toleranceSetCurrent)
        {
            _logMessage = null;
            _toleranceSet = _toleranceSetCurrent ?? new ToleranceSetsModel { MaxTotal = 100, OrderVal = 1 };
            _isAddMode = string.IsNullOrEmpty(_toleranceSet.UUID);
            
            // Load current tolerance ranges for the "Add Range" functionality
            await LoadCurrentToleranceRanges();
        }

        await base.OnParametersSetAsync();
    }

    private async Task LoadCurrentToleranceRanges()
    {
        if (!string.IsNullOrEmpty(_toleranceSet.UUID))
        {
            try
            {
                _currentToleranceRanges = await TolerancesService.GetToleranceRanges(_toleranceSet.UUID);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading tolerance ranges: {ex.Message}");
                _currentToleranceRanges = null;
            }
        }
        else
        {
            _currentToleranceRanges = null;
        }
    }

    private void AddCurrentRangeToDescription()
    {
        if (_currentToleranceRanges == null || !_currentToleranceRanges.Any())
        {
            return;
        }

        var sortedRanges = _currentToleranceRanges.OrderBy(r => r.RangeStart).ToList();
        
        // Calculate threshold - next value that has a score larger than 0
        var threshold = CalculateThreshold(sortedRanges);
        
        var rangeText = "<br><strong>Tolerance Configuration:</strong><br>";
        
        // Add threshold information
        if (threshold.HasValue)
        {
            rangeText += $"<strong>Threshold:</strong> {threshold.Value:F0}%<br><br>";
        }
        else
        {
            rangeText += "<strong>Threshold:</strong> No threshold found<br><br>";
        }
        
        // Add ranges header
        rangeText += "<strong>Tolerance Ranges:</strong><br>";
        
        foreach (var range in sortedRanges)
        {
            var startText = range.RangeStart?.ToString("F0") ?? "0";
            var endText = range.RangeEnd?.ToString("F0") ?? "∞";
            var scoreText = range.Score.ToString("F0");
            
            rangeText += $"{startText}% - {endText}% = {scoreText}%<br>";
        }

        // Append to existing description or set if empty
        if (string.IsNullOrWhiteSpace(_toleranceSet.Description))
        {
            _toleranceSet.Description = rangeText;
        }
        else
        {
            _toleranceSet.Description += rangeText;
        }

        StateHasChanged();
    }

    private decimal? CalculateThreshold(List<ToleranceRangesModel> sortedRanges)
    {
        // Find ranges with score > 0
        var rangesWithPositiveScore = sortedRanges.Where(r => r.Score > 0).ToList();
        
        if (!rangesWithPositiveScore.Any())
        {
            return null; // No ranges with positive scores
        }
        
        // Get the range with the lowest start value that has a positive score
        var firstPositiveRange = rangesWithPositiveScore.OrderBy(r => r.RangeStart).First();
        
        // The threshold is the start of this range
        return firstPositiveRange.RangeStart ?? 0;
    }

    private async Task SaveToleranceSet()
    {
        if (_toleranceSet == null || string.IsNullOrWhiteSpace(_toleranceSet.Name))
        {
            _logMessage = new ResultsModel { isValid = false, Message = "Please enter a name for the tolerance set." };
            return;
        }

        try
        {
            _isSaving = true;
            StateHasChanged();

            _logMessage = await TolerancesService.SaveToleranceSet(_toleranceSet);
            
            if (_logMessage != null && _logMessage.isValid == true && _toleranceSet.UUID == null)
            {
                _toleranceSet.UUID = _logMessage.UUID;
                _isAddMode = false;
                
                // Load tolerance ranges after creating new tolerance set
                await LoadCurrentToleranceRanges();
            }

            await OnSaveComplete.InvokeAsync(_toleranceSet);
            _rightSidebarService.TriggerDataRefresh(Enumerables.ControlTypes.sb_Goals_Administration_ToleranceSets);
        }
        catch (Exception ex)
        {
            _logMessage = new ResultsModel { isValid = false, Message = $"Error saving tolerance set: {ex.Message}" };
            Console.WriteLine($"Error saving tolerance set: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnDelete_Confirm(MouseEventArgs args)
    {
        string message = "Are you sure you want to delete this tolerance set?";
        string title = "Delete Tolerance Set";

        var result = await DialogService.Confirm(message, title, new ConfirmOptions()
        {
            OkButtonText = "Yes",
            CancelButtonText = "No"
        });

        // Only proceed with deletion if the user explicitly clicked "Yes"
        if (result.HasValue && result.Value)
        {
            await OnDelete_Click();
        }
    }

    private async Task OnDelete_Click()
    {
        try
        {
            _isSaving = true;
            StateHasChanged();

            _logMessage = await TolerancesService.DeleteToleranceSet(_toleranceSet.UUID);
            _rightSidebarService.TriggerDataRefresh(Enumerables.ControlTypes.sb_Goals_Administration_ToleranceSets);
        }
        catch (Exception ex)
        {
            _logMessage = new ResultsModel { isValid = false, Message = $"Error deleting tolerance set: {ex.Message}" };
            Console.WriteLine($"Error deleting tolerance set: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsRangesTabSelected()
    {
        // Ranges tab is index 1
        return _selectedTabIndex == 1;
    }

    private async Task OnRangeChanged()
    {
        // Reload tolerance ranges when ranges change
        await LoadCurrentToleranceRanges();
        StateHasChanged();
    }

    private void ClosePanel()
    {
        _rightSidebarService?.Close();
    }

    public void Dispose()
    {
        // Clean up if needed
    }
}
