@using Library.API.Goals.Models
@using Library.API.Goals.Models.Pillars
@using Library.API.Goals.Services
@using Library.API.Admin.Models
@using Library.API.Admin.Services
@using OneCoreAssessUI.Models
@using OneCoreAssessUI.Services

@inject DialogService DialogService

 

<RadzenStack class="header-custom">
    <RadzenStack class="header-outer">
        <RadzenStack>
            <RadzenText TextStyle="TextStyle.DisplayH3" class="header-label" Text="Pillar" />
        </RadzenStack>
    </RadzenStack>
</RadzenStack>

@* Status Messages *@
@if (_logMessage != null && _logMessage.isValid.HasValue)
{
    <div class="rz-alert @(_logMessage.isValid.Value ? "rz-success-light" : "rz-danger-light")" style="margin-bottom: 1rem; display: flex; align-items: center;">
        <RadzenIcon Icon=@(_logMessage.isValid.Value ? "check_circle" : "error") Style="margin-right: 8px;" />
        <span>@_logMessage.Message</span>
    </div>
}

@if (_pillar != null)
{
    <RadzenStack class="p-4">
        <RadzenColumn Size="12">
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Name</RadzenText>
            <RadzenTextBox Placeholder="Pillar Name..."
                           @bind-Value="_pillar.Name"
                           Style="width: 100%"
                           aria-label="Pillar Name" />
        </RadzenColumn>

        <RadzenColumn Size="12">
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Description</RadzenText>
            <RadzenTextArea oninput="event.target.style.height = Math.max(event.target.clientHeight, event.target.scrollHeight) + 'px';"
                            @bind-Value="_pillar.Description"
                            Style="width: 100%"
                            aria-label="Description" />
        </RadzenColumn>

        <RadzenColumn Size="12">
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Icon</RadzenText>
            <RadzenDropDown @bind-Value="_pillar.Icons"
                            Data="_icons"
                            Style="width: 100%;"
                            TextProperty="@nameof(NameOnlyModel.Name)"
                            ValueProperty="@nameof(NameOnlyModel.Name)"
                            Name="DropDownBindValue"
                            Change="@OnIconChanged">
                <Template Context="data">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <RadzenIcon Icon="@data.Name" />
                        <span>@data.Name</span>
                    </div>
                </Template>
            </RadzenDropDown>
        </RadzenColumn>

        <RadzenColumn Size="12">
            <RadzenText Text="Icon Color" />
            <RadzenColorPicker @bind-Value="_pillar.IconColor"
                               ShowHSV=true
                               ShowRGBA=true
                               ShowColors=true
                               ShowButton=false />
        </RadzenColumn>

        <RadzenColumn Size="12">
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Display Order</RadzenText>
            <RadzenNumeric @bind-Value="_pillar.OrderVal"
                           Style="width: 100%;"
                           Min="0"
                           Max="9999"
                           Step="1"
                           aria-label="Display Order" />
        </RadzenColumn>

        <RadzenColumn Size="12" class="mt-5">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="8px" style="width: 100%">
                <RadzenButton style="flex: 1;"
                              Icon="save"
                              BusyText="Saving..."
                              IsBusy="_isSaving"
                              Click="@OnSave_Click"
                              Text="Save" />

                @if (!string.IsNullOrEmpty(_pillar?.UUID))
                {
                    <RadzenButton Icon="delete"
                                  Style="color: #fff; background-color: var(--rz-danger); width: 40px; min-width: 40px;"
                                  IsBusy="_isSaving"
                                  Click="OnDelete_Confirm" />
                }
            </RadzenStack>
        </RadzenColumn>
    </RadzenStack>
}

@code {
    [Inject] public IIconsService _IconsService { get; set; }
    [Inject] public IPillarsServices _PillarsService { get; set; }

    [CascadingParameter] public LayoutCascadeMenuModel _menuNav { get; set; }
    [CascadingParameter] public RightSidebarService _rightSidebarService { get; set; }

    [Parameter] public PillarsModel? Pillar { get; set; }
    [Parameter] public EventCallback<PillarsModel> OnSaveComplete { get; set; }

    private ResultsModel? _logMessage = null;
    private PillarsModel? _pillar = null;
    private PillarsModel? _pillarCurrent = null;
    private bool _isSaving = false;
    private List<NameOnlyModel>? _icons;

    protected override async Task OnInitializedAsync()
    {
        if (_pillar == null) _pillar = new PillarsModel() { IconColor = "#362f21" };
        await LoadIcons();
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        //get data if its sent to the right sidebar area
        _pillarCurrent = _rightSidebarService.GetSharedContext<PillarsModel>();
        
        if (_pillar != null && _pillarCurrent == null) 
            _pillar = new PillarsModel() { IconColor = "#362f21" };

        if (_pillarCurrent != null && _pillar != _pillarCurrent)
        {
            _logMessage = null;
            _pillar = _pillarCurrent;
            // Set the icon name based on IconsId if available
            if (_icons != null && !String.IsNullOrEmpty(_pillar.Icons) )
            {
                var icon = _icons.FirstOrDefault(i => i.Name == _pillar.Icons);
                if (icon != null)
                {
                    _pillar.Icons = icon.Name;
                }
            }
        }

        await base.OnParametersSetAsync();
    }

    private async Task LoadIcons()
    {
        _icons = await _IconsService.GetIcons();
    }

    private void OnIconChanged()
    {
        if (_icons != null && !string.IsNullOrEmpty(_pillar?.Icons))
        {
            var selectedIcon = _icons.FirstOrDefault(i => i.Name == _pillar.Icons);
            if (selectedIcon != null)
            {
                _pillar.Icons = selectedIcon.Name ?? "account_balance";
            }
        }
    }

    private async Task OnSave_Click()
    {
        if (_pillar == null || string.IsNullOrWhiteSpace(_pillar.Name))
        {
            _logMessage = new ResultsModel { isValid = false, Message = "Please enter a name for the pillar." };
            return;
        }

        try
        {
            _isSaving = true;
            StateHasChanged();

            _logMessage = await _PillarsService.SavePillar(_pillar);
            
            if (_logMessage != null && _logMessage.isValid == true && _pillar.UUID == null)
            {
                _pillar.UUID = _logMessage.UUID;
            }
            
            await OnSaveComplete.InvokeAsync(_pillar);
            _rightSidebarService.TriggerDataRefresh(Enumerables.ControlTypes.sb_Goals_Administration_Pillars);
        }
        catch (Exception ex)
        {
            _logMessage = new ResultsModel { isValid = false, Message = $"Error saving pillar: {ex.Message}" };
            Console.WriteLine($"Error saving pillar: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnDelete_Confirm()
    {
        var result = await DialogService.Confirm("Are you sure?", "Delete Pillar", new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
        if (result.HasValue && result.Value)
        {
            await OnDelete_Click();
        }
    }

    private async Task OnDelete_Click()
    {
        try
        {
            _isSaving = true;
            StateHasChanged();

            _logMessage = await _PillarsService.DeletePillar(_pillar.UUID);
            _rightSidebarService.TriggerDataRefresh(Enumerables.ControlTypes.sb_Goals_Administration_Pillars);
        }
        catch (Exception ex)
        {
            _logMessage = new ResultsModel { isValid = false, Message = $"Error deleting pillar: {ex.Message}" };
            Console.WriteLine($"Error deleting pillar: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
