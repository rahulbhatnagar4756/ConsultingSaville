    public void Dispose()
    {
        try
        {
            // Unsubscribe from the data refresh event
            if (_rightSidebarService != null)
            {
                _rightSidebarService.OnDataRefresh -= HandleDataRefresh;
            }

            // Cleanup timers with null checks
            if (_pillarTimers != null)
            {
                foreach (var timer in _pillarTimers.Values)
                {
                    timer?.Dispose();
                }
                _pillarTimers.Clear();
            }

            if (_kpaTimers != null)
            {
                foreach (var timer in _kpaTimers.Values)
                {
                    timer?.Dispose();
                }
                _kpaTimers.Clear();
            }

            if (_kpiTimers != null)
            {
                foreach (var timer in _kpiTimers.Values)
                {
                    timer?.Dispose();
                }
                _kpiTimers.Clear();
            }

            if (_kpiLinkedTimers != null)
            {
                foreach (var timer in _kpiLinkedTimers.Values)
                {
                    timer?.Dispose();
                }
                _kpiLinkedTimers.Clear();
            }
        }
        catch (Exception ex)
        {
            // Log the exception if needed, but don't throw from Dispose
            Console.WriteLine($"Error during component disposal: {ex.Message}");
        }
    }

