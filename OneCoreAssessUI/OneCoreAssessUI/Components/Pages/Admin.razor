<style>

    :root {
    --sc-primary-colour1: @PrimaryColor1;
    --sc-primary-colour2: @PrimaryColor2;
    --sc-secondary-color1: @SecondaryColor1;
    --sc-secondary-color2: @SecondaryColor2;
    --sc-secondary-color3: @SecondaryColor3;
    --sc-secondary-color4: @SecondaryColor4;
    --sc-card-background-colour: #dedfde;
    --sc-card-background-colour-daker: #b1b3b2;
    --rz-primary: @SecondaryColor4;
        --header-color1: #00BF6370;
        --header-color2: #7ED95770;
        --header-color3: #FFDE5970;
        --header-color4: #FF575770;
        --header-color5: #7AB3E170;
        --header-color6: #7AB3E180;
    }

    .sb-sidebar-right { 
    width: @GetSidebarWidth(); 
    max-width: 100vw;
    }

    .top-bar .rz-menu  {
    margin-top: 6px;
    }

   /*  @@media only screen and (max-width:767px)
